     /** "Get WABA" — GET /{{WABA-ID}} */
     public function getWaba(string $wabaId, ?array $fields = null): array
     {
-        $fields ??= [
-            'id', 'name', 'currency', 'timezone_id', 'message_template_namespace', 'account_review_status',
