APP_NAME=Engage
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=engage
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Meta / WhatsApp Business Platform
# ---------------------------------------------------------------------------
# Graph API version used for every request (Postman collection {{Version}}).
WHATSAPP_GRAPH_VERSION=v25.0
# Embedded Signup version passed to FB.login extras (v4 is current; v2 is deprecated 15 Oct 2026).
WHATSAPP_EMBEDDED_SIGNUP_VERSION=v4

# Meta App (App Dashboard > App settings > Basic)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Facebook Login for Business > Configurations > "WhatsApp Embedded Signup" configuration ID
WHATSAPP_CONFIG_ID=

# Your (partner) business portfolio ID and a permanent System User token with
# business_management + whatsapp_business_management + whatsapp_business_messaging.
# Used for partner-level calls (shared WABAs list, credit line sharing, system-user assignment)
# and as a fallback when a customer token is unavailable.
WHATSAPP_BUSINESS_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
# ID of the system user to assign to onboarded WABAs (optional). Leave empty to skip.
WHATSAPP_SYSTEM_USER_ID=

# tech_provider (default) or solution_partner. Solution partners additionally share a
# line of credit with each onboarded WABA (Embedded Signup collection, Step 3).
WHATSAPP_PARTNER_TYPE=tech_provider
WHATSAPP_CREDIT_LINE_ID=
WHATSAPP_DEFAULT_WABA_CURRENCY=USD

# Webhook verification token you set in App Dashboard > WhatsApp > Configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# When true, inbound webhooks must carry a valid X-Hub-Signature-256 header.
WHATSAPP_WEBHOOK_VERIFY_SIGNATURE=true
